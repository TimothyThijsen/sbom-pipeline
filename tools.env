GRYPE_VERSION=0.121.1
GRYPE_SHA256_LINUX_AMD64=bc3ea3f9e6fd56ac781c08c6c5e614271b79f438200757f6932085c19b0a4657

# jq filters grype.json in the blocking gate.
# Checksum: https://github.com/jqlang/jq/releases/download/jq-<ver>/sha256sum.txt (line jq-linux-amd64)
JQ_VERSION=1.8.2
